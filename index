<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1, viewport-fit=cover">

  <title>圖卡 AR 學習平台</title>

  <script src="https://aframe.io/releases/1.6.0/aframe.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>

  <style>
    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: sans-serif;
      background: transparent;
    }

    #panel {
      position: fixed;
      top: 16px;
      left: 16px;
      right: 16px;
      z-index: 100;
      padding: 16px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 4px 20px #0002;
    }

    h1 {
      margin: 0 0 8px;
      font-size: 21px;
    }

    #status {
      margin: 8px 0 12px;
      line-height: 1.6;
      font-size: 15px;
    }

    button {
      padding: 12px 20px;
      border: 0;
      border-radius: 10px;
      background: #176b57;
      color: white;
      font-size: 17px;
    }

    button:disabled {
      background: #888;
    }

    .hint {
      margin-top: 10px;
      font-size: 13px;
      color: #555;
    }
  </style>

  <script>
    // 自動縮放並置中模型。
    // 模型最長邊會縮放為辨識圖卡寬度的約 0.8 倍。
    AFRAME.registerComponent('fit-model', {
      init: function () {
        this.el.addEventListener('model-loaded', () => {
          const model = this.el.getObject3D('mesh');
          const THREE = AFRAME.THREE;

          model.updateMatrixWorld(true);

          const box = new THREE.Box3().setFromObject(model);
          const size = box.getSize(new THREE.Vector3());
          const center = box.getCenter(new THREE.Vector3());
          const longest = Math.max(size.x, size.y, size.z);

          if (!Number.isFinite(longest) || longest <= 0) {
            window.dispatchEvent(new Event('invalid-model'));
            return;
          }

          const scale = 0.8 / longest;

          // 調整 mesh，保留外層實體供之後旋轉使用。
          model.scale.multiplyScalar(scale);
          model.position.sub(center.multiplyScalar(scale));
          model.updateMatrixWorld(true);

          window.dispatchEvent(new Event('model-ready'));
        });
      }
    });
  </script>
</head>

<body>
  <div id="panel">
    <h1>圖卡 AR 學習平台</h1>

    <div id="status">正在載入 3D 模型……</div>

    <button id="start" disabled>載入中</button>

    <div class="hint">
      啟動後，請將後鏡頭對準指定圖卡。
      移動手機，可以從不同角度觀察模型。
    </div>
  </div>

  <a-scene
    mindar-image="
      imageTargetSrc: ./targets.mind;
      autoStart: false;
      uiLoading: no;
      uiScanning: no;
      uiError: no;
    "
    renderer="colorManagement: true; alpha: true"
    vr-mode-ui="enabled: false"
    device-orientation-permission-ui="enabled: false"
  >
    <a-camera
      position="0 0 0"
      look-controls="enabled: false"
    ></a-camera>

    <a-entity
      light="type: ambient; intensity: 1"
    ></a-entity>

    <a-entity
      light="type: directional; intensity: 1"
      position="1 2 3"
    ></a-entity>

    <a-entity
      id="target"
      mindar-image-target="targetIndex: 0"
    >
      <!--
        rotation 可依模型調整，例如：
        0 0 0
        90 0 0
        -90 0 0
      -->
      <a-entity
        id="model"
        gltf-model="url(./model.glb)"
        fit-model
        position="0 0 0.15"
        rotation="0 0 0"
      ></a-entity>
    </a-entity>
  </a-scene>

  <script>
    const scene = document.querySelector('a-scene');
    const target = document.querySelector('#target');
    const model = document.querySelector('#model');
    const start = document.querySelector('#start');
    const status = document.querySelector('#status');

    let modelReady = false;
    let sceneReady = scene.hasLoaded;
    let starting = false;

    function updateButton() {
      if (modelReady && sceneReady) {
        start.disabled = false;
        start.textContent = '啟動 AR 鏡頭';
        status.textContent = '模型已載入，請按下按鈕開始。';
      }
    }

    scene.addEventListener('loaded', () => {
      sceneReady = true;
      updateButton();
    });

    window.addEventListener('model-ready', () => {
      modelReady = true;
      updateButton();
    });

    window.addEventListener('invalid-model', () => {
      status.textContent = '模型沒有可顯示的有效尺寸，請檢查 GLB 檔案。';
    });

    model.addEventListener('model-error', () => {
      status.textContent =
        '模型載入失敗。請確認 model.glb 與 index.html 在同一資料夾，'
        + '並檢查模型是否包含材質及貼圖。';
    });

    function showCameraError(error) {
      console.error(error);
      status.textContent =
        'AR 啟動失敗：請確認已允許相機權限、使用 HTTPS 網址，'
        + '並檢查 targets.mind 是否存在。修正後重新整理頁面。';

      start.disabled = true;
      start.textContent = '請重新整理後再試';
    }

    scene.addEventListener('arError', showCameraError);

    start.addEventListener('click', async () => {
      if (starting) return;

      if (!window.isSecureContext ||
          !navigator.mediaDevices?.getUserMedia) {
        status.textContent =
          '目前無法使用相機，請用手機瀏覽器開啟 HTTPS 網址。';
        return;
      }

      starting = true;
      start.disabled = true;
      start.textContent = '啟動中';
      status.textContent = '正在啟動鏡頭，請允許相機權限……';

      try {
        const ar = scene.systems['mindar-image-system'];
        await ar.start();

        start.hidden = true;
        status.textContent = '請將鏡頭對準完整圖卡。';
      } catch (error) {
        showCameraError(error);
      }
    });

    target.addEventListener('targetFound', () => {
      status.textContent = '辨識成功！請移動手機觀察 3D 模型。';
    });

    target.addEventListener('targetLost', () => {
      status.textContent = '圖卡離開鏡頭，請重新對準圖卡。';
    });

    window.addEventListener('pagehide', () => {
      const ar = scene.systems['mindar-image-system'];
      if (ar) ar.stop();
    });
  </script>
</body>
</html>
